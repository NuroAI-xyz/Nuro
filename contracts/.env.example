# --- NuroStaking deployment (EVM / Robinhood Chain) ---

# Deployer private key (0x-prefixed; forge accepts it as-is)
PRIVATE_KEY=0x...

# $NURO ERC-20 address (Robinhood Chain)
STAKE_TOKEN=0x3bbe06f1fa1eee18dd4bc4092c79294a9a24e262

# Reward token. Set EQUAL to STAKE_TOKEN so stakers earn $NURO: the treasury
# tops the pool up over time via fundRewards(), and compound() is enabled.
# (Use a stable's address here instead only if you ever want USDG real-yield.)
REWARD_TOKEN=0x3bbe06f1fa1eee18dd4bc4092c79294a9a24e262

# Unstake cooldown in seconds (0 = instant, 86400 = 1 day, max 604800 = 7 days)
UNSTAKE_COOLDOWN=0

# Admin address (can only set tokens once / tune cooldown / rescue non-core
# tokens; can NEVER move, seize, or slash user funds)
OWNER=0x63172b76B5a97c6AE653c736BcA2989Be40Fb719

# --- Network (Robinhood Chain mainnet) ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api
ETHERSCAN_API_KEY=<blockscout-verify-key>
