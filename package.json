{
  "name": "nuro",
  "private": true,
  "description": "Nuro AI - inference network powered by contributed compute",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev:website": "pnpm --filter nuro-website dev",
    "dev:data": "pnpm --filter nuro-data dev",
    "dev:client": "pnpm --filter @nuroaixyz/worker dev",
    "dev:orchestrator": "pnpm --filter @nuro/orchestrator dev",
    "build:website": "pnpm --filter nuro-website build",
    "build:data": "pnpm --filter nuro-data build",
    "build:client": "pnpm --filter @nuroaixyz/worker build",
    "build:orchestrator": "pnpm --filter @nuro/orchestrator build"
  }
}
